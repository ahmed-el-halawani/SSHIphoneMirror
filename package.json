{
  "name": "iphone-mirror",
  "productName": "iPhone Mirror",
  "version": "0.3.1",
  "description": "Connect your Mac's iOS Simulator to a Windows desktop",
  "author": "Ahmed Elhalawany",
  "private": true,
  "license": "UNLICENSED",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "dev.local.iphone-mirror",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**",
      "vendor/**",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@44.9.3": true
  }
}
