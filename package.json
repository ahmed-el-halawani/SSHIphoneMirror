{
  "name": "iphone-mirror",
  "productName": "iPhone Mirror",
  "version": "0.3.1",
  "description": "Connect your Mac's iOS Simulator to a Windows desktop",
  "author": "Ahmed Elhalawany",
  "private": true,
  "license": "UNLICENSED",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis",
    "mcp": "node app/mcp/server.mjs",
    "test:live": "node tests/live-headless.mjs",
    "test:coordination": "node tests/live-coordination.cjs"
  },
  "build": {
    "appId": "dev.local.iphone-mirror",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**",
      "vendor/**",
      "THIRD-PARTY-NOTICES.md",
      "package.json",
      "installers/mac-idb/**",
      "!app/**/__pycache__/**",
      "docs/**",
      "README.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@44.9.3": true
  }
}
